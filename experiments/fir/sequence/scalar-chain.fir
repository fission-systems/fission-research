step=0 address=0x1000 offset=0 length=4 raw=00020480 body=0 name="s_add_u32" fields=[("source0", 0), ("source1", 2), ("destination", 4)]
evidence=[Evidence { source_id: "amd-vega-sadd-u32", url: "https://www.amd.com/content/dam/amd/en/documents/radeon-tech-docs/instruction-set-architectures/vega-shader-instruction-set-architecture.pdf", revision: "Vega ISA document 70656, 2020-01-27; sections 5.3, 5.4 Table 10", claim: "S_ADD_U32 writes the low 32-bit unsigned sum to SDST and carry-out to SCC. Generic registers map to SGPR slots; flag 0 maps to SCC. Only SGPR 0..95 are admitted." }, Evidence { source_id: "llvm-sop2-gfx900", url: "https://github.com/llvm/llvm-project/blob/llvmorg-22.1.0/llvm/lib/Target/AMDGPU/SOPInstructions.td", revision: "llvmorg-22.1.0; SOP2_Real32 and S_ADD_U32_vi", claim: "Opcode zero; source0 bits 0..7, source1 bits 8..15, destination bits 16..22. This profile admits SGPR 0..95 and excludes inline constants, special selectors and literals." }]
step=1 address=0x1004 offset=4 length=4 raw=01030582 body=1 name="s_addc_u32" fields=[("source0", 1), ("source1", 3), ("destination", 5)]
evidence=[Evidence { source_id: "amd-vega-saddc-u32", url: "https://www.amd.com/content/dam/amd/en/documents/radeon-tech-docs/instruction-set-architectures/vega-shader-instruction-set-architecture.pdf", revision: "Vega ISA document 70656, 2020-01-27; SOP2 section 12.1", claim: "S_ADDC_U32 reads SCC before effects, writes the low 32-bit unsigned sum of both sources and SCC to SDST, and writes carry-out to SCC. Generic registers map to SGPR slots; flag 0 maps to SCC. Only SGPR 0..95 are admitted." }, Evidence { source_id: "llvm-sop2-gfx900", url: "https://github.com/llvm/llvm-project/blob/llvmorg-22.1.0/llvm/lib/Target/AMDGPU/SOPInstructions.td", revision: "llvmorg-22.1.0; SOP2_Real32 and S_ADDC_U32_vi", claim: "Opcode 0x04; source0 bits 0..7, source1 bits 8..15, destination bits 16..22. This profile admits SGPR 0..95 and excludes inline constants, special selectors and literals." }]
