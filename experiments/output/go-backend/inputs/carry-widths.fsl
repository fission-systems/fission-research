# Synthetic fixed-width arithmetic contract; not an ISA profile.
language go.arithmetic {
byte_order little; address_unit byte;
instruction carry1 {
 encoding 32 mask 0xfffff000 value 0x1000 {
  field left offset 0 bits 4; field right offset 4 bits 4; field destination offset 8 bits 4;
 }
 mnemonic "synthetic.carry1";
 evidence "self-authored" "synthetic" "v1" "Carry-in/out and ordered read/write at width 1; no ISA claim.";
 semantics {
  %left: u1 = register.read left;
  %right: u1 = register.read right;
  %carry_in: u1 = flag.read 0;
  %sum: u1 = u1.add.carry %left, %right, %carry_in;
  %carry: u1 = int.add.carry.in %left, %right, %carry_in;
  register.write destination, %sum; flag.write 0, %carry;
 }
}
instruction carry8 {
 encoding 32 mask 0xfffff000 value 0x2000 {
