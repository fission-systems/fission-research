digraph fsl_fpga_add {
  // Untimed dependency projection; no CGRA mapping.
  in0 [label="input slot 0"];
  in1 [label="input slot 1"];
  v0 [label="FIR op 0: stack.pop (8 bits)"];
  in1 -> v0;
  v1 [label="FIR op 1: stack.pop (8 bits)"];
  in0 -> v1;
  v2 [label="FIR op 2: add.wrap (8 bits)"];
  v1 -> v2;
  v0 -> v2;
  out0 [label="output slot 0"];
  v2 -> out0;
}
