digraph fsl_tensor_dot2 {
  // Untimed dependency projection; no CGRA mapping.
  in0 [label="input slot 0"];
  in1 [label="input slot 1"];
  in2 [label="input slot 2"];
  in3 [label="input slot 3"];
  v0 [label="FIR op 0: stack.pop (8 bits)"];
  in3 -> v0;
  v1 [label="FIR op 1: stack.pop (8 bits)"];
  in2 -> v1;
  v2 [label="FIR op 2: stack.pop (8 bits)"];
  in1 -> v2;
  v3 [label="FIR op 3: stack.pop (8 bits)"];
  in0 -> v3;
  v4 [label="FIR op 4: convert (32 bits)"];
  v3 -> v4;
  v5 [label="FIR op 5: convert (32 bits)"];
  v2 -> v5;
  v6 [label="FIR op 6: convert (32 bits)"];
  v1 -> v6;
  v7 [label="FIR op 7: convert (32 bits)"];
  v0 -> v7;
  v8 [label="FIR op 8: mul.wrap (32 bits)"];
  v4 -> v8;
  v6 -> v8;
  v9 [label="FIR op 9: mul.wrap (32 bits)"];
  v5 -> v9;
  v7 -> v9;
  v10 [label="FIR op 10: add.wrap (32 bits)"];
  v8 -> v10;
  v9 -> v10;
  out0 [label="output slot 0"];
  v10 -> out0;
}
