digraph fsl_rc_euler_step {
  // Untimed dependency projection; no CGRA mapping.
  in0 [label="input slot 0"];
  in1 [label="input slot 1"];
  v0 [label="FIR op 0: stack.pop (16 bits)"];
  in1 -> v0;
  v1 [label="FIR op 1: stack.pop (16 bits)"];
  in0 -> v1;
  v2 [label="FIR op 2: convert (32 bits)"];
  v1 -> v2;
  v3 [label="FIR op 3: convert (32 bits)"];
  v0 -> v3;
  v4 [label="FIR op 4: constant (32 bits)"];
  v5 [label="FIR op 5: constant (32 bits)"];
  v6 [label="FIR op 6: mul.wrap (32 bits)"];
  v2 -> v6;
  v4 -> v6;
  v7 [label="FIR op 7: add.wrap (32 bits)"];
  v6 -> v7;
  v3 -> v7;
  v8 [label="FIR op 8: lshr (32 bits)"];
  v7 -> v8;
  v5 -> v8;
  v9 [label="FIR op 9: convert (16 bits)"];
  v8 -> v9;
  out0 [label="output slot 0"];
  v9 -> out0;
}
